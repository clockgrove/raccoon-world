{
  "extends": "../../.clockgrove/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2024",
      "DOM"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [],
    "paths": {
      "@pin/*": [
        "../../.clockgrove/*"
      ],
      "@clockgrove/contracts": [
        "../../.clockgrove/packages/contracts/src/index.ts"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
