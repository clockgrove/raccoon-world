{
  "extends": "../../.clockgrove/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2024",
      "DOM"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [],
    "paths": {
      "@pin/*": [
        "../../.clockgrove/*"
      ],
      "@clockgrove/contracts": [
        "../../.clockgrove/packages/contracts/src/index.ts"
      ],
      "three/addons/*": [
        "../../.clockgrove/apps/web/node_modules/@types/three/examples/jsm/*"
      ],
      "three/webgpu": [
        "../../.clockgrove/apps/web/node_modules/@types/three/src/Three.WebGPU.d.ts"
      ],
      "three/tsl": [
        "../../.clockgrove/apps/web/node_modules/@types/three/src/Three.TSL.d.ts"
      ],
      "three": [
        "../../.clockgrove/apps/web/node_modules/@types/three/src/Three.d.ts"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
