{
  "assertions": [
    {
      "id": "replay-matches",
      "kind": "path",
      "operator": "eq",
      "path": [
        "replay",
        "matches"
      ],
      "run": "main",
      "value": true
    },
    {
      "id": "aggregate-replay-matches",
      "kind": "path",
      "operator": "eq",
      "path": [
        "replay",
        "matches"
      ],
      "run": "aggregate",
      "value": true
    },
    {
      "equivalence": "small-step-vs-aggregate",
      "expect": true,
      "id": "small-step-equals-aggregate",
      "kind": "equivalence"
    },
    {
      "eventType": "needs.threshold-crossed",
      "id": "main-hunger-never-urgent",
      "kind": "eventCount",
      "operator": "eq",
      "run": "main",
      "value": 0,
      "where": [
        {
          "path": [
            "payload",
            "need"
          ],
          "value": "hunger"
        }
      ]
    },
    {
      "eventType": "needs.threshold-crossed",
      "id": "main-thirst-never-urgent",
      "kind": "eventCount",
      "operator": "eq",
      "run": "main",
      "value": 0,
      "where": [
        {
          "path": [
            "payload",
            "need"
          ],
          "value": "thirst"
        }
      ]
    },
    {
      "eventType": "needs.threshold-crossed",
      "id": "aggregate-hunger-never-urgent",
      "kind": "eventCount",
      "operator": "eq",
      "run": "aggregate",
      "value": 0,
      "where": [
        {
          "path": [
            "payload",
            "need"
          ],
          "value": "hunger"
        }
      ]
    },
    {
      "eventType": "needs.threshold-crossed",
      "id": "aggregate-thirst-never-urgent",
      "kind": "eventCount",
      "operator": "eq",
      "run": "aggregate",
      "value": 0,
      "where": [
        {
          "path": [
            "payload",
            "need"
          ],
          "value": "thirst"
        }
      ]
    }
  ],
  "equivalences": [
    {
      "eventTypes": [
        "environment.phase-changed",
        "weather.transitioned",
        "growth.stage-changed",
        "lifecycle.stage-changed",
        "lifecycle.born",
        "lifecycle.died"
      ],
      "fields": [
        "events",
        "finalState"
      ],
      "id": "small-step-vs-aggregate",
      "ignoreStatePaths": [
        [
          "revision"
        ]
      ],
      "left": "main",
      "right": "aggregate"
    }
  ],
  "kind": "clockgrove.scenario",
  "name": "long-run-30-days",
  "pack": {
    "id": "clockgrove.green-lake-yard",
    "version": "1.3.0"
  },
  "recording": "summarised",
  "schemaVersion": 1,
  "steps": [
    {
      "key": "span",
      "kind": "advance",
      "mode": "live",
      "stepMs": {
        "$bigint": "86400000"
      },
      "to": {
        "$bigint": "11232000000"
      }
    }
  ],
  "variants": [
    {
      "name": "aggregate",
      "steps": [
        {
          "key": "span",
          "kind": "advance",
          "mode": "fast-forward",
          "to": {
            "$bigint": "11232000000"
          }
        }
      ]
    }
  ]
}
