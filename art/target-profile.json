{
  "format": "assetgrove-target-profile/1",
  "name": "raccoon-world",
  "license": "MIT",
  "acceptedLicenses": [
    "CC-BY-4.0"
  ],
  "style": {
    "alpha": {
      "mode": "soft",
      "threshold": 16
    },
    "color": {
      "rule": "full"
    },
    "edges": "antialiased"
  },
  "values": {
    "creator": "Clockgrove",
    "provider": "vercel-ai-gateway",
    "palette": [
      "#1c1b1f",
      "#282323",
      "#556836",
      "#5e3d28",
      "#5f6b75",
      "#6b6662",
      "#7e96a9",
      "#ae9675",
      "#e2d7c2",
      "#f2a348"
    ]
  },
  "frames": {
    "width": 32,
    "height": 32,
    "maxEdge": 2048,
    "durationMs": 250
  },
  "layout": {
    "media": "assets/source/{{spec.assetId}}/{{spec.animationFamily}}.{{output.extension}}",
    "manifest": "assets/manifests/{{spec.assetId}}/{{spec.animationFamily}}.json",
    "provenance": "assets/source/{{spec.assetId}}/{{spec.animationFamily}}.{{output.extension}}.provenance.json"
  },
  "manifest": {
    "assetManifestVersion": 2,
    "assetId": "{{spec.assetId}}",
    "animationFamily": "{{spec.animationFamily}}",
    "source": {
      "kind": "generated",
      "path": "{{output.path}}",
      "creator": "{{profile.creator}}",
      "tool": "assetgrove"
    },
    "license": "{{provenance.license}}",
    "provenance": {
      "prompt": "{{provenance.prompt}}",
      "references": "{{provenance.referenceHashes}}",
      "model": "{{provenance.calls.0.model}}",
      "provider": "{{profile.provider}}",
      "route": "{{provenance.calls.0.route}}",
      "providerTermsVersion": "{{provenance.calls.0.providerTerms}}",
      "outputGrant": "{{provenance.outputGrant}}"
    },
    "review": {
      "status": "pending",
      "reviewer": null,
      "reviewedAt": null,
      "notes": ""
    },
    "semantic": "{{spec.fields.semantic}}",
    "frames": "{{output.frames}}",
    "anchor": "{{output.anchor}}",
    "footprint": "{{spec.fields.footprint}}",
    "bounds": "{{output.bounds}}",
    "palette": "{{profile.palette}}",
    "contentHash": "{{output.sha256}}",
    "atlas": "{{spec.fields.atlas}}",
    "accessibilityLabel": "{{spec.fields.accessibilityLabel}}"
  },
  "review": {
    "path": "review.status",
    "pending": "pending"
  },
  "validator": {
    "command": [
      "bash",
      "scripts/validate-asset.sh",
      "{{manifest}}"
    ]
  },
  "identity": {
    "mode": "shadow",
    "threshold": 0.68,
    "question": "score"
  },
  "animation": {
    "gait": "quadruped",
    "thresholds": {
      "edgeHaloShare": 0.3
    },
    "matting": {
      "check": "art/tools/fringe.mjs",
      "fringeShare": 0.15,
      "calibration": {
        "$comment": "Recomputed by art/tools/check.mjs (calibrate in art/tools/fringe.mjs). The limit sits between the worst approved frame and the lowest fringed counter-example, both made at run time from the approved cell (no new material): fringed keeps the background in its soft edge; paleFringed is the cell turned pale fur on a pale #f2efe8 background, which Assetgrove's 64-distance edge-halo check passes; softStrands adds soft strands of the figure's own colour, which must pass. The unapproved real Assetgrove strips in references/stevie/comparison-candidates score at most 0.07.",
        "approved": {
          "frames": 114,
          "worstShare": 0.0115,
          "sources": "every approved manifest's strip (assets/manifests/*/*.json with review approved, split into its frames, against the cell's background, #e0e0e0 and #ffffff) and Jimothy's approved soft-alpha identity-lock cell references/jimothy/sheet-cell-03.png against its contact sheet's background"
        },
        "counterExamples": {
          "fringed": 0.6493,
          "paleFringed": 0.6555,
          "softStrands": 0.0051
        },
        "background": "#e5f0ee"
      }
    }
  }
}
